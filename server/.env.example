# The server reads the .env in the project root (see dotenv.config in index.js),
# so copy these lines into ../.env rather than into a file here.

# Signs every session token. Required in production; generate one with
#   openssl rand -hex 32
JWT_SECRET=

# The Gemini key. Server side only: it is never sent to the browser, and every
# AI request goes through POST /api/ai/* with a signed-in account.
# On Fly:  flyctl secrets set GEMINI_API_KEY=...
GEMINI_API_KEY=

# Where the front end is served from, for CORS.
CLIENT_URL=http://localhost:5000

SERVER_PORT=3001
# Defaults to server/db/jeopardy.sqlite in development and /data/jeopardy.sqlite
# in production.
# DATABASE_PATH=
