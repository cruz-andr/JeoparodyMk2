# Dependencies
node_modules

# Build output
dist/

# Environment files
.env
.env.local
.env.*.local
# Timestamped copies made before editing .env. They hold the same live keys as
# .env itself, so they have to be ignored by the same rule or one stray
# `git add -A` publishes them.
.env.bak*
*.env.bak*

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
CLAUDE.md

# Design canvas working files (the seeded page is ~2MB)
.design-work/*.html
!.design-work/*.dc.html

# Throwaway databases the server test suites boot against
server/test/tmp-*.sqlite*
e2e/tmp-*.sqlite*

# Screenshots the browser suite takes while it runs
e2e/shots/

# Claude Code worktrees for parallel agents
.claude/worktrees/
